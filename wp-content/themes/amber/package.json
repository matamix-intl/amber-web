{
  "name": "amber-theme",
  "version": "1.0.0",
  "description": "Amber — premium business & SaaS WordPress theme. SCSS build tooling.",
  "private": true,
  "license": "GPL-2.0-or-later",
  "scripts": {
    "build:css": "sass assets/scss/main.scss assets/css/main.css --style=compressed --no-source-map",
    "build:editor": "sass assets/scss/editor.scss assets/css/editor.css --style=compressed --no-source-map",
    "build": "npm run build:css && npm run build:editor",
    "watch": "sass --watch assets/scss/main.scss assets/css/main.css assets/scss/editor.scss:assets/css/editor.css"
  },
  "devDependencies": {
    "sass": "^1.77.0"
  }
}
