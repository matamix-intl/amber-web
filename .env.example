TRAEFIK_HOST=ambererp.app
TRAEFIK_ROUTER_NAME=amber-web
TRAEFIK_CERT_RESOLVER=myresolver
CONTAINER_NAME=amber-web

WORDPRESS_DB_HOST=mysql:3306
WORDPRESS_DB_NAME=amber_web_dev
WORDPRESS_DB_USER=root
WORDPRESS_DB_PASSWORD=<set-on-server>
WORDPRESS_TABLE_PREFIX=wp_
WORDPRESS_DEBUG=false
WORDPRESS_HOME=https://ambererp.app
WORDPRESS_SITEURL=https://ambererp.app

# Generate at https://api.wordpress.org/secret-key/1.1/salt/ and set on server:
# WORDPRESS_AUTH_KEY=
# WORDPRESS_SECURE_AUTH_KEY=
# WORDPRESS_LOGGED_IN_KEY=
# WORDPRESS_NONCE_KEY=
# WORDPRESS_AUTH_SALT=
# WORDPRESS_SECURE_AUTH_SALT=
# WORDPRESS_LOGGED_IN_SALT=
# WORDPRESS_NONCE_SALT=
